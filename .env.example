# ==================================================
# SD Associates CRM - Environment Configuration Example
# Copy this file to .env and adjust values as needed
# ==================================================

# Server Configuration
PORT=4000
HOST=localhost
NODE_ENV=development

# Application Details
APP_NAME="SD Associates CRM"
APP_DESCRIPTION="Vehicle Loan & Insurance Management System"

# MongoDB Atlas Configuration
# Replace <username> and <password> with your Atlas Database user credentials
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.d0z9kkn.mongodb.net/?retryWrites=true&w=majority
DB_NAME=sd_associates_crm
